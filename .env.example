DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# Ajusta estos orígenes a la URL privada o HTTPS que uses en tu instalación.
DJANGO_SECURE_COOKIES=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=0
DATABASE_PATH=/app/data/db.sqlite3
MEDIA_ROOT=/app/data/media
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=90
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=/run/secrets/enable_banking_private_key
ENABLE_BANKING_API_URL=https://api.enablebanking.com
ENABLE_BANKING_REDIRECT_URL=https://your-domain.example/bancos/enable-banking/callback/
LOCAL_LLM_URL=http://ollama:11434
LOCAL_LLM_MODEL=qwen3:1.7b
