{
  "name": "mis-cuentas-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 127.0.0.1 --port 5173",
    "preview": "vite preview --config vite.config.ts",
    "build": "tsc -b && npm run check:privacy && npm run check:css && vite build --config vite.config.ts && node scripts/check-build.mjs",
    "brand:icons": "node scripts/render-brand-icons.mjs",
    "typecheck": "tsc -b",
    "check:architecture": "node scripts/check-architecture.mjs --strict-feature-deps && node --test scripts/check-architecture.node.mjs && node scripts/check-ledger-archetype.mjs && node scripts/check-test-scopes.mjs && npm run check:privacy",
    "check:privacy": "node scripts/check-sensitive-formatting.mjs",
    "check:css": "node scripts/check-css-ownership.mjs",
    "test": "vitest run",
    "test:ui-lab": "vitest run --mode ui-lab-test",
    "test:coverage": "vitest run --coverage",
    "test:css-parser": "node --test scripts/check-css-ownership.node.mjs",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --config playwright.chromium.config.ts",
    "test:e2e:webkit": "playwright test --config playwright.webkit.config.ts",
    "test:e2e:ui-lab-mobile": "npm run test:e2e:ui-lab:full",
    "test:e2e:charts": "npm run build && playwright test --config playwright.charts.config.ts",
    "test:e2e:update": "playwright test --update-snapshots",
    "build:ci": "vite build --config vite.config.ts && node scripts/check-build.mjs",
    "test:e2e:ui-lab": "playwright test --config playwright.ui-lab.config.ts",
    "test:e2e:ui-lab:focused": "playwright test --config playwright.ui-lab.config.ts --project=chromium --grep @focused",
    "test:e2e:ui-lab:focused:webkit": "playwright test --config playwright.ui-lab.config.ts --project=webkit --grep @focused",
    "test:e2e:ui-lab:selection": "playwright test --config playwright.ui-lab.config.ts --grep @selection",
    "test:e2e:ui-lab:native": "playwright test --config playwright.ui-lab.config.ts --grep @native",
    "test:e2e:ui-lab:responsive": "playwright test --config playwright.ui-lab.config.ts --grep @responsive",
    "test:e2e:ui-lab:reduced-motion": "playwright test --config playwright.ui-lab.config.ts --grep @reduced-motion",
    "test:e2e:ui-lab:critical": "playwright test --config playwright.ui-lab.config.ts --grep @critical",
    "test:e2e:ui-lab:full": "playwright test --config playwright.ui-lab.config.ts --grep @full"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "ag-charts-community": "14.0.2",
    "ag-charts-locale": "14.0.2",
    "ag-charts-react": "14.0.2",
    "lucide-react": "^0.468.0",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "uplot": "1.6.32",
    "vite": "^6.4.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "4.1.12",
    "jsdom": "^25.0.1",
    "playwright": "^1.61.1",
    "typescript": "^5.6.3",
    "vitest": "4.1.12"
  }
}
